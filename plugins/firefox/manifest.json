{
  "manifest_version": 2,
  "name": "Docent",
  "version": "0.1.1",
  "description": "Explain, translate, or ask about the text you are reading, with the page as context.",
  "browser_specific_settings": {
    "gecko": {
      "id": "{ae094259-bf49-44a7-a0f0-186c52340b02}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent", "browsingActivity"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "48": "icons/docent.svg",
    "96": "icons/docent.svg"
  },
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "menus",
    "storage",
    "notifications"
  ],
  "background": {
    "page": "background.html",
    "persistent": true
  },
  "browser_action": {
    "default_title": "Docent",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/docent.svg"
  },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Open the Docent profile picker"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  }
}
