#!/usr/bin/env python3
"""Run the docent adapter from zathura."""

from __future__ import annotations

import sys
from pathlib import Path


def main() -> int:
    """Load the package from this checkout and run the CLI."""
    sys.path.insert(0, str(Path(__file__).resolve().parent))
    from docent_zathura.cli import main as cli_main

    return cli_main()


if __name__ == "__main__":
    raise SystemExit(main())
